apiVersion: v1
kind: Secret
metadata:
  name: nkod-secrets
  namespace: nodc
data:
  AccessTokenKey:
  AccessTokenKeyPassword:
  DecryptionCertificateFile:
  DecryptionCertificatePassword:
  EmailOptionsPassword:
  EmailOptionsUser:
  GoogleClientId:
  GoogleClientSecret:
  HarvesterAuthToken:
  JwtPublicKey:
  MysqlConnectionString:
  MysqlConnectionStringNotificationService:
  MysqlPassword:
  MysqlUserPassword:
  SigningCertificateFile:
  SigningCertificatePassword:
type: Opaque
